{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["sfo1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/astrology/memory-sync",
      "schedule": "5 10 * * *"
    },
    {
      "path": "/api/astrology/memory-sync",
      "schedule": "5 22 * * *"
    }
  ]
}
