# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# ── Stripe ──────────────────────────────────────────────────────────────────
# Get from dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Stripe CLI: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_

# Stripe Price IDs — create in dashboard.stripe.com/live/products
# Charter Annual: $49/yr (recurring, interval=year)
STRIPE_PRICE_ID_CHARTER=price_live_charter_annual
# Member Annual: $99/yr (recurring, interval=year)
STRIPE_PRICE_ID_STANDARD=price_live_member_annual
# Member Monthly: $12.99/mo (recurring, interval=month)
STRIPE_PRICE_ID_MEMBER_MONTHLY=price_live_member_monthly

# ── Site ────────────────────────────────────────────────────────────────────
# Used for absolute URLs (e.g. Stripe return URLs, OG meta)
NEXT_PUBLIC_SITE_URL=https://getsos.app
